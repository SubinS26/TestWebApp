{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/styles/*", "/js/*", "/comments/*", "/groups/*", "/users/*", "/api/*"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
