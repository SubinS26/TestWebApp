# =================================================================
# TestWebApp - Azure & Local Environment Configuration
# =================================================================

# Server Port (Azure App Service automatically sets PORT=8080 or uses dynamic port)
PORT=4300

# Client Session Secret (Change to a unique secure string in production)
SESSION_SECRET_LETTER="your-secure-random-session-secret-key-change-in-prod"

# -----------------------------------------------------------------
# Azure Database for MySQL Flexible Server / Local MySQL
# -----------------------------------------------------------------
# For Azure MySQL: set to your server name, e.g., 'cw2-videoshare-db.mysql.database.azure.com'
# For Local MySQL: set to '127.0.0.1'
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=react-instagram-clone
# Set to 'true' if connecting to Azure Database for MySQL (enables SSL)
MYSQL_SSL=true

# -----------------------------------------------------------------
# Azure Blob Storage (Video and Asset Persistence)
# -----------------------------------------------------------------
# Connection string from Azure Portal -> Storage Account -> Access keys
AZURE_STORAGE_CONNECTION_STRING=
# Container name for uploaded media assets (default: 'posts')
AZURE_STORAGE_CONTAINER=posts

# -----------------------------------------------------------------
# Mailer Configuration (Nodemailer for password resets & verification)
# -----------------------------------------------------------------
MAIL=rtr.shrestha.subin@gmail.com
MAIL_PASSWORD=your_mail_app_password

# -----------------------------------------------------------------
# Optional Integrations & Admin Credentials
# -----------------------------------------------------------------
GOOGLE_GEOLOCATION_KEY=
ADMIN_PASSWORD=SuperAdmin@1047
